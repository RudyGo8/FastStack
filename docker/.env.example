# Docker 生产部署环境变量
# 复制为 docker/.env 后填写；含特殊字符的密码用单引号包裹
# Bash 与 Compose 共用 KEY=value 格式

# 部署环境与数据目录
DEPLOY_ENV=prod
DEBUG=false
# 生产数据根目录：数据库、Redis、上传文件、日志都在这里，与仓库和发布文件隔离
# 服务器上建议改成绝对路径，例如 DATA_DIR=/data/faststack/prod
DATA_DIR=./volumes/prod

# 数据库配置（PostgreSQL 18 + pgvector）
DATABASE_TYPE=postgres
DATABASE_NAME=faststack
DATABASE_USER=postgres
DATABASE_PASSWORD='your_database_password'
# 仅绑定 127.0.0.1，对外不暴露数据库端口
DATABASE_PORT=5432
# 需要向量检索时置为 true；关闭时启动不会创建 pgvector 扩展
VECTOR_STORE_ENABLE=false

# Redis 配置
REDIS_PASSWORD='your_redis_password'
REDIS_PORT=6379

# 后端配置
BACKEND_PORT=8001
BACKEND_IMAGE_TAG=0.1.0
LOGGER_LEVEL=INFO

# Nginx 配置
HTTP_PORT=80
HTTPS_PORT=443

# 项目配置
PROJECT_NAME=FastStack

# ── MySQL 兼容栈（docker compose --profile legacy-mysql up -d 时使用）──
MYSQL_ROOT_PASSWORD='your_mysql_root_password'
MYSQL_DATABASE=faststack
MYSQL_PORT=3306
