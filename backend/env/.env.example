# ==================================
# 环境配置文件:修改名称example为.env.dev或.env.prod 修改内容：ENVIRONMENT、SECRET_KEY、DATABASE_PASSWORD、REDIS_PASSWORD、OPENAI_API_KEY
# ==================================

ENVIRONMENT = dev # prod

# 服务器配置
SERVER_HOST = localhost
SERVER_PORT = 8001
# 前置可信反向代理跳数：docker 部署默认单层 nginx（默认 1）；后端直接暴露公网时填 0，防止 X-Forwarded-For 伪造
# TRUSTED_PROXY_HOPS = 1

# 文档配置
DEBUG = True
VERSION = 0.1.0

# 是否启用演示模式
DEMO_ENABLE = False

# 数据库配置：mysql-3306、postgres-5432、sqlite
DATABASE_TYPE = mysql
DATABASE_HOST = localhost
DATABASE_PORT = 3309
DATABASE_USER = root
DATABASE_PASSWORD = your_database_password
DATABASE_NAME = sopfast_mysql

# Redis配置
REDIS_HOST = localhost
REDIS_PORT = 6381
REDIS_USER = ''
REDIS_PASSWORD = your_redis_password
REDIS_DB_NAME = 1

# 日志级别配置
LOGGER_LEVEL = DEBUG

# 大模型配置
OPENAI_BASE_URL = https://api.deepseek.com
OPENAI_API_KEY = your_api_key
OPENAI_MODEL = deepseek-v4-flash

# ==================================
# SOP 模块配置（收编自 SopAgent）
# ==================================
# 模块总开关：false 时不启动 MCP 监听/快照调度等后台任务
SOP_ENABLE = true

# SOP 模型（OpenAI 兼容接口）
ARK_API_KEY =
BASE_URL = https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL = qwen3.8-flash
GRADE_MODEL = deepseek-v4-flash-0731
REWRITE_MODEL = deepseek-v4-flash-0731
EXPAND_MODEL = qwen-flash
ROUTER_MODEL = deepseek-v4-flash-0731
RERANK_MODEL = qwen3.7-text-rerank
RERANK_BINDING_HOST = https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY =
FALLBACK_MODEL = qwen3.8-max
EVAL_MODEL = glm-5.2
MAIN_MODEL_THINKING = false

# 向量模型
EMBEDDER = qwen3.7-text-embedding
EMBEDDING_DIM = 1536

# RAG
AUTO_MERGE_ENABLED = true
AUTO_MERGE_THRESHOLD = 2
LEAF_RETRIEVE_LEVEL = 3

# SOP 业务表所在 MySQL（与上方 DATABASE_* 同实例同库）
MYSQL_USERNAME = root
MYSQL_PASSWORD = your_database_password
MYSQL_HOST = localhost
MYSQL_PORT = 3309
MYSQL_DATABASE = sopfast_mysql

# SOP 模块 Redis（db2 与脚手架 db1 隔离）
SOP_REDIS_URL = redis://localhost:6381/2
REDIS_KEY_PREFIX = sop_agent
REDIS_CACHE_TTL_SECONDS = 300

# Milvus
MILVUS_HOST = localhost
MILVUS_PORT = 19532
MILVUS_COLLECTION = sop_embeddings

# MCP 工具开关
MCP_ENABLED = false

# ===== S&OP 公司数据仓库（只读；不配置时页面只展示待接入状态）=====
SOP_SOURCE_MYSQL_HOST =
SOP_SOURCE_MYSQL_PORT = 3306
SOP_SOURCE_MYSQL_DATABASE = big_data_dw
SOP_SOURCE_MYSQL_USERNAME =
SOP_SOURCE_MYSQL_PASSWORD =
